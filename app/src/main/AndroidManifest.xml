<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Goi Gemini va Supabase. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Quet ma QR. Xin luc bam nut, khong xin luc mo app. -->
    <uses-permission android:name="android.permission.CAMERA" />
    <!-- Ghi am gan trong ghi chu. Xin luc bam nut, khong xin luc mo app. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- Nhac su kien / ghi chu dung gio. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" />

    <!-- May khong co camera van cai duoc app; chi la khong quet duoc QR. -->
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <uses-feature android:name="android.hardware.microphone" android:required="false" />

    <!--
      `enableOnBackInvokedCallback` CO Y de false.

      Bat len thi tu Android 13 he thong BO QUA `onBackPressed()` va luon lam
      hanh vi mac dinh (dong man hinh). Ma o day nut back phai lam viec khac:
      man chinh thi lui mot buoc (thoat che do chon > xoa o tim > ve tat ca ghi
      chu) truoc khi thoat app, man tro ly thi dong ngan keo truoc. Bat cai co do
      la moi phan xu ly do im lang khong chay, khong bao loi gi.

      Doi lai la khong co hoat anh "back doan truoc" cua Android 14. Doi duoc
      khi nao dang ky OnBackInvokedCallback cho tung man.
    -->
    <application
        android:name="com.ghichu.Ung"
        android:label="@string/ten_app"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:theme="@style/ThemeGhiChu"
        android:supportsRtl="true"
        android:allowBackup="true"
        android:enableOnBackInvokedCallback="false">

        <activity
            android:name="com.ghichu.ManHinhChinhActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name="com.ghichu.SuaGhiChuActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name="com.ghichu.BanDoActivity"
            android:exported="false" />

        <activity
            android:name="com.ghichu.LichTrinhActivity"
            android:exported="false" />

        <activity
            android:name="com.ghichu.TroLyAiActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name="com.ghichu.QuetQrActivity"
            android:exported="false"
            android:screenOrientation="portrait" />

        <activity
            android:name="com.ghichu.DongBoActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name="com.ghichu.CaiDatGiaoDienActivity"
            android:exported="false" />

        <!--
          Dua tep xuat (anh, PDF, van ban) ra cho app khac doc khi chia se.
          `exported="true"` + `grantUriPermissions` la cach duy nhat de app nhan
          chia se mo duoc tep; quyen chi cap cho DUNG uri gui kem intent, va lop
          nay chi phuc vu thu muc `cache/chiase`.
        -->
        <provider
            android:name="com.ghichu.TepChiaSe"
            android:authorities="com.ghichu.tep"
            android:exported="true"
            android:grantUriPermissions="true" />

        <!--
          Nhan bao thuc nhac nho, va nhan tin khoi dong xong de hen lai.
          `exported="true"` vi ANH `BOOT_COMPLETED` la broadcast cua he thong.
        -->
        <receiver
            android:name="com.ghichu.BaoThuc"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <!--
          Widget Ghi chu (nen kinh). `exported="true"` la BAT BUOC voi moi widget:
          he thong goi broadcast tu tien trinh khac vao day.
        -->
        <receiver
            android:name="com.ghichu.GhiChuWidget"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/ghichu_widget_ghichu_info" />
        </receiver>

        <!--
          Widget Lich trinh. `exported="true"` la BAT BUOC: he thong widget goi
          broadcast tu tien trinh khac vao day, dat false la widget khong bao gio
          duoc ve.
        -->
        <receiver
            android:name="com.ghichu.LichTrinhWidget"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/ghichu_widget_lich_info" />
        </receiver>
    </application>
</manifest>
