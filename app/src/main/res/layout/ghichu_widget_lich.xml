<?xml version="1.0" encoding="utf-8"?>
<!--
  Widget Lịch trình: các sự kiện SẮP TỚI, mỗi dòng hai cột —
  cột trái = thứ + ngày, cột phải = tên + giờ.

  KHÁC bản cũ: danh sách nay CUỘN được. Dùng `ListView` + `RemoteViewsService`
  (xem LichTrinhWidgetService) thay cho lối `addView` từng dòng — lịch dài bao
  nhiêu cũng kéo xem hết, không còn bị cắt ở đáy widget.

  BA RÀNG BUỘC CỦA RemoteViews, đừng quên:
   1. KHÔNG dùng thẻ <View> trơn — RemoteViews chỉ nhận LinearLayout /
      FrameLayout / TextView / ImageView / ListView… Muốn vạch ngăn thì dùng
      TextView cao 1dp. Sai điều này là widget báo "Không thể tải tiện ích".
   2. `ListView` phải có `RemoteViewsService` cấp dòng, khai báo service trong
      manifest với quyền BIND_REMOTEVIEWS.
   3. Màu chữ do code đặt lúc chạy (theo giao diện sáng/tối), giá trị ở đây chỉ
      là mặc định cho lúc xem trước trong bảng chọn widget.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/ghichu_widget_goc"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/ghichu_kinh_toi"
    android:padding="14dp">

    <TextView
        android:id="@+id/ghichu_widget_dau"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Lịch trình"
        android:textColor="#F2F2F2"
        android:textSize="13sp"
        android:textStyle="bold"
        android:paddingBottom="6dp" />

    <!-- Vạch ngăn: TextView cao 1dp, KHÔNG được dùng thẻ <View>. -->
    <TextView
        android:id="@+id/ghichu_widget_vach"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#22FFFFFF" />

    <!--
      ListView cuộn + view "rỗng" chồng lên nhau trong FrameLayout: đây là mẫu
      chuẩn của setEmptyView — danh sách trống thì ListView tự ẩn, chữ "không có
      sự kiện" hiện ra.
    -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:paddingTop="4dp">

        <ListView
            android:id="@+id/ghichu_widget_ds"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:divider="@null"
            android:dividerHeight="0dp"
            android:scrollbars="vertical"
            android:fadeScrollbars="false" />

        <TextView
            android:id="@+id/ghichu_widget_trong"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:text="Không có sự kiện sắp tới"
            android:textColor="#CCFFFFFF"
            android:textSize="13sp" />
    </FrameLayout>
</LinearLayout>
