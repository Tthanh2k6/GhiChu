<?xml version="1.0" encoding="utf-8"?>
<!--
  Widget Ghi chú (nền kính): vài ghi chú gần nhất.

  BA RÀNG BUỘC CỦA RemoteViews, đừng quên:
   1. KHÔNG dùng thẻ <View> trơn — RemoteViews chỉ nhận LinearLayout /
      FrameLayout / TextView / ImageView… Muốn vạch ngăn thì dùng TextView
      cao 1dp. Sai điều này là widget báo "Không thể tải tiện ích".
   2. Danh sách KHÔNG cuộn: thêm thẳng từng dòng vào `ghichu_gc_khung`.
   3. Màu chữ do code đặt lúc chạy (theo giao diện sáng/tối); giá trị ở đây chỉ
      là mặc định cho ô xem trước trong bảng chọn widget.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/ghichu_gc_goc"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/ghichu_kinh_toi"
    android:padding="14dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingBottom="6dp">

        <TextView
            android:id="@+id/ghichu_gc_dau"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Ghi chú"
            android:textColor="#F2F2F2"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/ghichu_gc_them"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="+"
            android:textColor="#FFBF0F"
            android:textSize="20sp"
            android:paddingStart="10dp"
            android:paddingEnd="4dp" />
    </LinearLayout>

    <!-- Vạch ngăn: TextView cao 1dp, KHÔNG được dùng thẻ <View>. -->
    <TextView
        android:id="@+id/ghichu_gc_vach"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#22FFFFFF" />

    <LinearLayout
        android:id="@+id/ghichu_gc_khung"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:paddingTop="4dp" />
</LinearLayout>
